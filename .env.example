# URL publique de l’application web Apps Script (déploiement /exec, pas /dev).
PUBLIC_QUOTE_FORM_URL=

# Adresse publique actuelle ; remplacer par le domaine définitif puis reconstruire.
PUBLIC_SITE_URL=https://courant.abou-chahine-nael.workers.dev

# true pour une préproduction, false pour autoriser l’indexation du site public.
# Sur Cloudflare, renseigner explicitement cette valeur dans les variables de build.
PUBLIC_NOINDEX=false
