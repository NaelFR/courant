---
import BurgerMenu from "../assets/burger-menu.svg";
import CloseIcon from "../assets/close-icon.svg";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  id="menu-toggle"
  type="button"
  aria-label="Ouvrir le menu"
  aria-expanded="false"
  aria-controls="main-navigation"
  class:list={[
    "group inline-flex size-11 shrink-0 items-center justify-center text-vanille",
    "focus-visible:outline-2 focus-visible:outline-offset-4",
    className,
  ]}
>
  <BurgerMenu aria-hidden="true" class="group-aria-expanded:hidden" />
  <CloseIcon aria-hidden="true" class="hidden group-aria-expanded:block" />
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const navigation = document.querySelector<HTMLElement>("#main-navigation");

  if (button && navigation) {
    const desktop = window.matchMedia("(min-width: 80rem)");
    const header = button.closest("header");

    const setOpen = (open: boolean) => {
      navigation.dataset.open = String(open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute(
        "aria-label",
        open ? "Fermer le menu" : "Ouvrir le menu",
      );
    };

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    header?.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setOpen(false);
        if (!desktop.matches && navigation.contains(document.activeElement)) {
          button.focus({ preventScroll: true });
        }
      }
    });

    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !header?.contains(event.target)) {
        setOpen(false);
      }
    });

    // Do not reopen an old mobile menu after returning from the desktop layout.
    desktop.addEventListener("change", () => setOpen(false));

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        button.getAttribute("aria-expanded") === "true"
      ) {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>
