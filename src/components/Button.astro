---
import type { HTMLAttributes } from "astro/types";

interface Props extends Pick<HTMLAttributes<"button">, "type" | "disabled" | "aria-label" | "aria-describedby"> {
  variant: "orange" | "bordeaux" | "vanille" | "outlined";
  className?: string;
  href?: string;
  fullWidth?: boolean;
}

const { variant, className = "", href, fullWidth = false, type = "button", ...props } = Astro.props;
const Tag = href ? "a" : "button";

const variantClassnames = {
  vanille:
    "bg-vanille text-bordeaux hover:opacity-80 focus:bg-vanille/80 focus:outline-vanille",
  orange: "bg-orange hover:opacity-80 focus:bg-orange/80 focus:outline-orange",
  bordeaux:
    "bg-bordeaux text-vanille hover:opacity-80 focus:bg-bordeaux/80 focus:outline-bordeaux ",
  outlined:
    "bg-transparent border border-2 border-vanille text-vanille hover:bg-white/10 focus:bg-white/20 focus:outline-vanille ",
};
---

<Tag
  href={href}
  type={href ? undefined : type}
  class={`${variantClassnames[variant]} inline-flex items-center justify-center text-center font-cal-sans whitespace-nowrap py-3 px-4 sm:px-5 rounded-full min-h-14 ${fullWidth ? "w-full" : "w-fit"} ${className}`}
  {...props}
>
  <slot />
</Tag>
