---
import Contactform from "../Contactform.astro";
import type { SiteSettings } from "../../data/site-types";
import { phoneHref } from "../../lib/site-content";

interface Props { settings: SiteSettings }
const { settings } = Astro.props;
---

<section id="contact" class="bg-bordeaux py-14 px-4">
  <div
    class="mx-auto max-w-7xl flex flex-col xl:flex-row xl:items-center gap-8 xl:gap-12 2xl:gap-18"
  >
    <div class="min-w-0 flex-1 text-center xl:text-left">
      <h2 class="text-h4 text-vanille lg:text-h2">
        Discutons de <span class="text-orange">votre projet</span>.
      </h2>

      <p class="mt-4 text-body-md text-rose lg:text-body-lg">
        Je réponds sous 48 à 72h. Le devis est gratuit et sans engagement.
      </p>

      <dl class="mt-8 divide-y divide-dashed divide-gris/50">
        <div
          class="grid grid-cols-1 items-center gap-2 py-6
             md:grid-cols-[7rem_minmax(0,1fr)] md:gap-6"
        >
          <dt class="text-body-lg text-rose">Téléphone</dt>

          <dd class="min-w-0 text-body-lg font-semibold text-vanille">
            <a
              href={phoneHref(settings.phone)}
              class="hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
            >
              {settings.phone}
            </a>
          </dd>
        </div>

        <div
          class="grid grid-cols-1 items-center gap-2 py-6
             md:grid-cols-[7rem_minmax(0,1fr)] md:gap-6"
        >
          <dt class="text-body-lg text-rose">Email</dt>

          <dd class="min-w-0 text-body-lg font-semibold text-vanille">
            <a
              href={`mailto:${settings.email}`}
              class="wrap-break-word hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
            >
              {settings.email}
            </a>
          </dd>
        </div>

        <div
          class="grid grid-cols-1 items-center gap-2 py-6
             md:grid-cols-[7rem_minmax(0,1fr)] md:gap-6"
        >
          <dt class="text-body-lg text-rose">Adresse</dt>

          <dd class="min-w-0 text-body-lg font-semibold text-vanille">
            {settings.street}<br />
            {settings.postalCode} {settings.city}
          </dd>
        </div>
      </dl>
    </div>
    <Contactform action="post" />
  </div>
</section>
