---
import { Image } from "astro:assets";
import LogoOrange from "../../assets/logo-orange.png";
import type { LegalPage, SiteSettings } from "../../data/site-types";
import { phoneHref } from "../../lib/site-content";
import { instagramUrl, type NavigationLink } from "../../data/navigation";

interface Props {
  settings: SiteSettings;
  links: NavigationLink[];
  legalPages: LegalPage[];
}
const { settings, links, legalPages } = Astro.props;
const automaticYear = settings.siteYear == null;
const year =
  settings.siteYear ??
  new Intl.DateTimeFormat("fr-FR", {
    year: "numeric",
    timeZone: "Europe/Paris",
  }).format(new Date());
---

<footer
  class="bg-bordeaux border-t border-bordeaux-clair pt-8 lg:pt-16 pb-12 px-4"
>
  <div class="mx-auto max-w-7xl pb-10 border-b border-gris/50 border-dashed">
    <div class="flex flex-col lg:flex-row gap-8">
      <div class="text-center lg:flex-1">
        <h2 class="text-orange text-body-lg font-cal-sans">Courant.</h2>
        <p class="text-body-md text-rose px-15 lg:px-0">
          {settings.specialties.join(" · ")}
        </p>
      </div>
      <div class="text-center lg:flex-1">
        <h2 class="text-orange text-body-lg font-cal-sans mb-6">À propos</h2>
        <ul class="text-body-md text-vanille space-y-3">
          {links.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>
      <div class="text-center lg:flex-1">
        <h2 class="text-orange text-body-lg font-cal-sans mb-6">Contact</h2>
        <ul class="text-body-md text-vanille space-y-3">
          <li><a href={phoneHref(settings.phone)}>{settings.phone}</a></li>
          <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
          <li><a href={instagramUrl}>Instagram · @courantabc</a></li>
        </ul>
      </div>
      <div class="text-center lg:flex-1">
        <h2 class="text-orange text-body-lg font-cal-sans mb-6">
          Zone d'intervention
        </h2>
        <ul class="text-body-md text-vanille space-y-3 px-15 lg:px-0">
          <li>Métropole lilloise & Weppes</li>
          <li>{settings.street} {settings.postalCode} {settings.city}</li>
        </ul>
      </div>
    </div>
    <Image
      src={LogoOrange}
      alt="Logo de l'entreprise Courant"
      class="w-full max-w-300 h-auto mt-8 lg:mt-16"
      height={173}
      width={1200}
      layout="fixed"
      quality="high"
    />
  </div>
  <div
    class="mt-8 lg:mt-12 text-center lg:text-left block lg:flex lg:justify-between lg:items-center mx-auto max-w-7xl"
  >
    <span class="text-rose text-body-md"
      >© <span data-current-year={automaticYear ? "" : undefined}>{year}</span> Courant.
      S.A.R.L. · SIRET {settings.siret}</span
    >
    {legalPages.length > 0 && <ul
      class="mt-6 lg:mt-0 text-body-md text-vanille space-y-3 lg:space-y-0 block lg:flex gap-0 lg:gap-8"
    >
      {legalPages.map(({ slug, title }) => <li><a href={`/${slug}/`}>{title}</a></li>)}
    </ul>}
  </div>
</footer>

<script>
  function updateYear() {
    const year = new Intl.DateTimeFormat("fr-FR", {
      year: "numeric",
      timeZone: "Europe/Paris",
    }).format(new Date());
    document.querySelectorAll("[data-current-year]").forEach((element) => {
      element.textContent = year;
    });
  }
  updateYear();
  document.addEventListener("astro:page-load", updateYear);
</script>
