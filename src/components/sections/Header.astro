---
import Button from "../Button.astro";
import { Image } from "astro:assets";
import LogoOrange from "../../assets/logo-orange.png";
import Burgermenu from "../Burgermenu.astro";
import type { NavigationLink } from "../../data/navigation";
import type { SiteSettings } from "../../data/site-types";
import { phoneHref } from "../../lib/site-content";

interface Props { links: NavigationLink[]; settings: SiteSettings }
const { links, settings } = Astro.props;
---

<header class="sticky top-0 z-50 bg-bordeaux border-b border-b-bordeaux-clair py-3 px-4">
  <div
    class="mx-auto flex max-w-7xl items-center
           xl:grid xl:grid-cols-[auto_1fr_auto] xl:gap-x-8"
  >
    <a
      href="/"
      class="shrink-0 xl:col-start-1 xl:row-start-1 xl:justify-self-start"
      aria-label="Courant — accueil"
    >
      <Image
        src={LogoOrange}
        alt="Logo de l'entreprise Courant"
        height={20}
        loading="eager"
        class="h-auto w-24 sm:w-auto"
        layout="fixed"
        quality="high"
      />
    </a>

    <div
      class="ml-auto flex items-center gap-3
             xl:col-start-3 xl:row-start-1 xl:ml-0 xl:justify-self-end"
    >
      <div class="hidden md:block">
      <Button variant="outlined" href={phoneHref(settings.phone)}>
        {settings.phone}
      </Button>
      </div>
      <Button variant="orange" href="/#contact">Devis gratuit</Button>
    </div>

    <Burgermenu class="ml-2 sm:ml-4 xl:hidden" />

    <nav
      id="main-navigation"
      aria-label="Navigation principale"
      data-open="false"
      class="absolute inset-x-0 top-full hidden max-h-[calc(100dvh-5rem)] overflow-y-auto
         border-b border-bordeaux-clair bg-bordeaux px-4 shadow-lg data-[open=true]:block
         xl:static xl:col-start-2 xl:row-start-1 xl:block xl:max-h-none xl:w-auto
         xl:overflow-visible xl:border-0 xl:px-0 xl:shadow-none"
    >
      <ul
        class="flex flex-col gap-8 py-9
               xl:flex-row xl:items-center xl:justify-center xl:gap-6 xl:py-0"
      >
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="text-vanille block py-2 font-cal-sans whitespace-nowrap hover:underline
                       focus-visible:outline-2 focus-visible:outline-offset-4"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
