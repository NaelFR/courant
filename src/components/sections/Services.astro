---
import Plug from "../../assets/servicesIcons/plug.svg";
import ElectricPanel from "../../assets/servicesIcons/electric-panel.svg";
import Flash from "../../assets/servicesIcons/flash.svg";
import HouseSetup from "../../assets/servicesIcons/house-setup.svg";
import Light from "../../assets/servicesIcons/light.svg";
import Shield from "../../assets/servicesIcons/shield.svg";

import type { Service } from "../../data/site-types";

interface Props { services: Service[] }
const { services } = Astro.props;
const icons = {
  plug: Plug,
  "house-setup": HouseSetup,
  flash: Flash,
  "electric-panel": ElectricPanel,
  shield: Shield,
  light: Light,
};

---

<section class="bg-vanille px-4 py-14">
  <div class="max-w-7xl mx-auto flex flex-col">
    <h4 class="text-bordeaux text-center text-h4 lg:text-h2">
      Mes services<span class="text-orange">.</span>
    </h4>

    <p class="text-center text-gris text-body-md lg:text-body-lg mt-2 mb-10">
      Particuliers et professionnels : j'interviens sur tout type de logement,
      de la prise qui ne fonctionne plus à la rénovation complète.
    </p>
    <div
      class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 justify-items-center"
    >
      {
        services.map(({ icon, name, description, exemples }) => {
          const Icon = icons[icon] ?? Plug;
          return (
          <div class="bg-white border-2 border-bordeaux rounded-3xl p-8 flex flex-col gap-6 max-w-89.5">
            <Icon />
            <div class="border-dashed border-b-2 border-gris/50 pb-6">
              <h6 class="mb-3 text-h6 lg:text-h5">{name}</h6>
              <p class="text-gris text-body-md lg:text-body-lg">
                {description}
              </p>
            </div>
            <div>
              <ul class="space-y-2">
                {exemples.map((exemple) => (
                  <li class="text-body-md lg:text-body-lg">
                    <span class="text-orange mr-2">•</span>
                    <span>{exemple}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          );
        })
      }
    </div>
  </div>
</section>
