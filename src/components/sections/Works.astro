---
import { getWorkImageUrl, type Work } from "../../data/works";
import { instagramUrl } from "../../data/navigation";

interface Props {
  works: Work[];
}

const { works } = Astro.props;


---

{works.length > 0 && (
<section id="realisations" class="bg-vanille px-4 py-14">
  <div class="mx-auto max-w-7xl">
    <div class="text-center flex flex-col gap-4 mb-10">
      <h2 class="text-bordeaux text-h4 lg:text-h2">
        Quelques réalisations récentes<span class="text-orange">.</span>
      </h2>
      <p class="text-body-md lg:text-body-lg text-gris">
        Découvrez-en plus sur mon compte instagram <a
          href={instagramUrl}
          class="text-vin underline">@courantabc</a
        >
      </p>
    </div>
    <div>
      <ul
        class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4
         lg:flex-wrap lg:justify-center lg:overflow-visible lg:pb-0"
      >
        {
          works.map((work) => (
            <li class="shrink-0 snap-start w-[min(20rem,100%)]">
              <img
                src={getWorkImageUrl(work, 320)}
                srcset={`${getWorkImageUrl(work, 320)} 320w, ${getWorkImageUrl(work, 640)} 640w`}
                sizes="(max-width: 352px) calc(100vw - 32px), 320px"
                width={320}
                height={422}
                loading="lazy"
                decoding="async"
                alt={work.alt}
                class="aspect-[320/422] w-full h-auto block rounded-3xl object-cover"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
)}
