---
import { getWorkImageUrl, type Work } from "../../data/works";

interface Props {
  works: Work[];
}

const { works } = Astro.props;


---

{works.length > 0 && (
<section class="bg-vanille px-4 py-14">
  <div class="mx-auto max-w-7xl">
    <div class="text-center flex flex-col gap-4 mb-10">
      <h4 class="text-h4 lg:text-h2">
        Quelques réalisations récentes<span class="text-orange">.</span>
      </h4>
      <p class="text-body-md lg:text-body-lg text-gris">
        Découvrez-en plus sur mon compte instagram <a
          href="_blank"
          class="text-vin underline">@courantabc</a
        >
      </p>
    </div>
    <div>
      <ul
        class="flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4
         lg:flex-wrap lg:justify-center lg:overflow-visible lg:pb-0"
      >
        {
          works.map(({ alt, src }) => (
            <li class="shrink-0 snap-start w-80 h-105.75">
              <img
                src={getWorkImageUrl(src, 320)}
                srcset={`${getWorkImageUrl(src, 320)} 320w, ${getWorkImageUrl(src, 640)} 640w`}
                sizes="320px"
                width={320}
                height={422}
                loading="lazy"
                decoding="async"
                alt={alt}
                class="w-80 h-105.75 block rounded-3xl object-cover"
              />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
)}
