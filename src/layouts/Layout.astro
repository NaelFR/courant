---
import "../styles/global.css";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import type { NavigationLink } from "../data/navigation";
import type { LegalPage, SiteSettings } from "../data/site-types";

interface Props {
  title: string;
  settings: SiteSettings;
  navigation: NavigationLink[];
  legalPages: LegalPage[];
}

const { title, settings, navigation, legalPages } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    <Header settings={settings} links={navigation} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer settings={settings} links={navigation} legalPages={legalPages} />
  </body>
</html>
