---
import "../styles/global.css";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import type { NavigationLink } from "../data/navigation";
import type { LegalPage, SiteSettings } from "../data/site-types";
import { instagramUrl } from "../data/navigation";
import { interventionCities } from "../data/locations";
import { getImage } from "astro:assets";
import LogoOrange from "../assets/logo-orange.png";

interface Props {
  title: string;
  description: string;
  settings: SiteSettings;
  navigation: NavigationLink[];
  legalPages: LegalPage[];
}

const { title, description, settings, navigation, legalPages } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, "/"), site).href;
const socialImage = new URL("/social-card.png", site).href;
const logo = await getImage({ src: LogoOrange, width: 600, format: "png" });
const business = {
  "@context": "https://schema.org",
  "@type": "Electrician",
  "@id": new URL("/#entreprise", site).href,
  name: "Courant",
  url: site.href,
  logo: new URL(logo.src, site).href,
  image: socialImage,
  telephone: settings.phone.replace(/[\s().-]/g, ""),
  email: settings.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: settings.street,
    postalCode: settings.postalCode,
    addressLocality: settings.city,
    addressCountry: "FR",
  },
  areaServed: interventionCities.map((name) => ({ "@type": "City", name })),
  sameAs: [instagramUrl],
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth motion-reduce:scroll-auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {import.meta.env.DEV && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Courant" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Courant — Électricité et dépannage dans la métropole lilloise et les Weppes"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content="Courant — Électricité et dépannage"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(business).replace(/</g, "\\u003c")}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenu" class="skip-link">Aller au contenu</a>
    <Header settings={settings} links={navigation} />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <Footer settings={settings} links={navigation} legalPages={legalPages} />
  </body>
</html>
