---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import Why from "../components/sections/Why.astro";
import Works from "../components/sections/Works.astro";
import Testimonies from "../components/sections/Testimonies.astro";
import Location from "../components/sections/Location.astro";
import Contact from "../components/sections/Contact.astro";

import { getSiteContent } from "../lib/site-content";
import { getNavigation } from "../data/navigation";

const { settings, services, testimonies, works, legalPages } = await getSiteContent();
const navigation = getNavigation(works.length > 0, testimonies.length > 0);
---

<Layout
  title="Courant — Électricien à Lille et dans les Weppes"
  description="Installation, rénovation et dépannage électrique à Lille et dans les Weppes. Cédric, votre interlocuteur du devis à la mise en service. Devis gratuit."
  settings={settings} navigation={navigation} legalPages={legalPages}
>
  <Hero settings={settings} />
  <div class="bg-vin px-4 py-8 lg:py-10 flex justify-center">
    <p class="text-rose text-center font-cal-sans text-h6">
      {settings.specialties.join(" · ")}
    </p>
  </div>
  <Services services={services} />
  <Why />
  <Works works={works} />
  <Testimonies testimonies={testimonies} />
  <Location />
  <Contact settings={settings} />
</Layout>
