---
import "../styles/global.css";

import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import Services from "../components/sections/Services.astro";
import Why from "../components/sections/Why.astro";
import Works from "../components/sections/Works.astro";
import Testimonies from "../components/sections/Testimonies.astro";
import Location from "../components/sections/Location.astro";
import Footer from "../components/sections/Footer.astro";
import Contact from "../components/sections/Contact.astro";

import { getSiteContent } from "../lib/site-content";

const { settings, services, testimonies, works } = await getSiteContent();
---

<Layout title="Courant - Électricite et dépannage">
  <Hero settings={settings} />
  <section class="bg-vin px-4 py-8 lg:py-10 flex justify-center">
    <h6 class="text-rose text-center">
      {settings.specialties.join(" · ")}
    </h6>
  </section>
  <Services services={services} />
  <Why />
  <Works works={works} />
  <Testimonies testimonies={testimonies} />
  <Location />
  <Contact settings={settings} />
  <Footer settings={settings} />
</Layout>
